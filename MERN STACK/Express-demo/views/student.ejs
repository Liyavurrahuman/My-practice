<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>student List</title>
</head>
<body>
    <h1>Student List</h1>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Course</th>
                <th>Status</th>
            </tr>
        </thead>
    
    <tbody>
        <% students.forEach((student) => { %>
            <tr>
                <td><%= student.id %></td>
                <td><%= student.name %></td>
                <td><%= student.age %></td>
                <td><%= student.course %></td>
                <td><%= student.status %></td>
                <td>
                    <%if(studen.age >= 18){%>
                        Adult
                    <%}
                     else {%>
                        Minor<%}
                        %>
                    
                </td>
            </tr>
        <% }); %>
    </tbody>

    </table>
</body>
</html>